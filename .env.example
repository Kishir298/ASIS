# A.S.I.S. configuration example.
#
# Copy to `.env` (project root) or set real environment variables.
# Precedence: explicit load_settings(env=...) > process environment
#            > .env files > built-in defaults. Empty values count as unset.
# Present-but-invalid values raise ConfigurationError (never silent).
# No real secrets belong in this file.

# ---- Identity (all optional strings) ----
ASIS_IDENTITY_NAME=A.S.I.S.
ASIS_IDENTITY_TITLE=A Smart Intelligence System
ASIS_APP_VERSION=0.1.0
ASIS_SHUTDOWN_PHRASE=asis shutdown

# ---- Runtime ----
# ASIS_DEBUG: boolean (1/true/yes/on/enabled or 0/false/no/off/disabled).
ASIS_DEBUG=false
# ASIS_LOG_LEVEL: one of DEBUG, INFO, WARNING, ERROR, CRITICAL.
ASIS_LOG_LEVEL=INFO
# ASIS_SHUTDOWN_TIMEOUT: positive integer seconds.
ASIS_SHUTDOWN_TIMEOUT=10

# ---- AI ----
# ASIS_AI_PROVIDER: provider name, e.g. ollama or mock (non-empty).
ASIS_AI_PROVIDER=ollama
# ASIS_AI_MODEL: model name, e.g. qwen2.5:3b (non-empty).
ASIS_AI_MODEL=qwen2.5:3b
# ASIS_AI_ENDPOINT: http(s) URL of the provider.
ASIS_AI_ENDPOINT=http://127.0.0.1:11434
# ASIS_AI_REQUEST_TIMEOUT: positive integer seconds.
ASIS_AI_REQUEST_TIMEOUT=120
# ASIS_AI_TEMPERATURE: number between 0 and 2.
ASIS_AI_TEMPERATURE=0.7
# ASIS_AI_MAX_CONTEXT_MESSAGES / ASIS_AI_CONTEXT_CHAR_LIMIT: positive integers.
ASIS_AI_MAX_CONTEXT_MESSAGES=20
ASIS_AI_CONTEXT_CHAR_LIMIT=12000

# ---- Conversation ----
# ASIS_CONVERSATION_MAX_HISTORY: positive integer.
ASIS_CONVERSATION_MAX_HISTORY=20

# ---- Memory ----
# ASIS_MEMORY_PROVIDER: storage backend (only 'local' supported).
ASIS_MEMORY_PROVIDER=local
# ASIS_MEMORY_DATABASE_NAME: safe file name (letters, digits, . _ -).
ASIS_MEMORY_DATABASE_NAME=memory.db

# ---- Voice: audio ----
# ASIS_VOICE_SAMPLE_RATE / CHANNELS / BLOCK_SIZE: positive integers.
ASIS_VOICE_SAMPLE_RATE=16000
ASIS_VOICE_CHANNELS=1
ASIS_VOICE_BLOCK_SIZE=1024
# ASIS_VOICE_INPUT_ENGINE / ASIS_VOICE_OUTPUT_ENGINE: mock or sounddevice.
ASIS_VOICE_INPUT_ENGINE=mock
ASIS_VOICE_OUTPUT_ENGINE=mock

# ---- Voice: speech recognition (STT) ----
# ASIS_VOICE_STT_ENGINE: mock or faster-whisper (non-empty).
ASIS_VOICE_STT_ENGINE=mock
# ASIS_VOICE_STT_MODEL / DEVICE / COMPUTE_TYPE: non-empty strings.
ASIS_VOICE_STT_MODEL=small
ASIS_VOICE_STT_DEVICE=cpu
ASIS_VOICE_STT_COMPUTE_TYPE=int8
# ASIS_VOICE_STT_LANGUAGE: empty means automatic detection.
ASIS_VOICE_STT_LANGUAGE=

# ---- Voice: text to speech (TTS) ----
# ASIS_VOICE_TTS_ENGINE: mock or pyttsx3 (non-empty).
ASIS_VOICE_TTS_ENGINE=mock
# ASIS_VOICE_TTS_VOICE: empty allowed when the provider auto-selects.
ASIS_VOICE_TTS_VOICE=male-default
# ASIS_VOICE_TTS_SAMPLE_RATE: positive integer.
ASIS_VOICE_TTS_SAMPLE_RATE=16000

# ---- Voice: speaker identification ----
# ASIS_VOICE_SPEAKER_ENGINE: mock or embedding (non-empty).
ASIS_VOICE_SPEAKER_ENGINE=mock
# ASIS_VOICE_SPEAKER_MODEL / DEVICE: non-empty strings.
ASIS_VOICE_SPEAKER_MODEL=speechbrain/spkrec-ecapa-voxceleb
ASIS_VOICE_SPEAKER_DEVICE=cpu
# ASIS_VOICE_SPEAKER_CONFIDENCE / THRESHOLD: numbers between 0 and 1.
ASIS_VOICE_SPEAKER_CONFIDENCE=0.6
ASIS_VOICE_SPEAKER_THRESHOLD=0.6
# ASIS_VOICE_SPEAKER_METRIC: non-empty, e.g. cosine.
ASIS_VOICE_SPEAKER_METRIC=cosine

# ---- Voice: wake word ----
# ASIS_VOICE_WAKE_WORD: required unless the wake engine is mock/none/off.
ASIS_VOICE_WAKE_WORD=hey asis
# ASIS_VOICE_WAKE_ENGINE: mock or openwakeword (non-empty).
ASIS_VOICE_WAKE_ENGINE=mock
# ASIS_VOICE_WAKE_THRESHOLD: number between 0 and 1.
ASIS_VOICE_WAKE_THRESHOLD=0.5
# ASIS_VOICE_WAKE_MODEL: optional model path (may be empty).
ASIS_VOICE_WAKE_MODEL=

# ---- Voice: VAD ----
# ASIS_VOICE_VAD_ENGINE: mock or silero (non-empty).
ASIS_VOICE_VAD_ENGINE=mock
# ASIS_VOICE_VAD_THRESHOLD: number between 0 and 1.
ASIS_VOICE_VAD_THRESHOLD=0.5
# ASIS_VOICE_MAX_UTTERANCE_S: positive number, max command capture.
ASIS_VOICE_MAX_UTTERANCE_S=15.0
# ASIS_VOICE_SILENCE_S: positive number, silence ending an utterance.
ASIS_VOICE_SILENCE_S=0.8

# ---- Network ----
# ASIS_NETWORK_TIMEOUT: positive integer seconds (Ollama health + requests).
ASIS_NETWORK_TIMEOUT=10
# ASIS_NETWORK_RETRIES: integer >= 0 (chat request retries).
ASIS_NETWORK_RETRIES=3

# ---- Tools ----
# ASIS_TOOL_TIMEOUT: positive integer seconds per tool run.
ASIS_TOOL_TIMEOUT=30

# ---- Security ----
# ASIS_CONFIRM_DANGEROUS_TOOLS: boolean, confirmation gate for tools.
ASIS_CONFIRM_DANGEROUS_TOOLS=true

# ---- Assistant modes (A.S.C.S. is the coding mode of A.S.I.S.) ----
# ASIS_DEFAULT_MODE: general or coding (non-empty).
ASIS_DEFAULT_MODE=general

# ---- Coding workspace (A.S.C.S.) ----
# ASIS_CODING_WORKSPACE: workspace root directory (empty means launch CWD).
ASIS_CODING_WORKSPACE=
# ASIS_CODING_COMMAND_TIMEOUT: positive integer seconds per command run.
ASIS_CODING_COMMAND_TIMEOUT=120
# ASIS_CODING_MAX_FILE_SIZE: positive integer max bytes read/written per file.
ASIS_CODING_MAX_FILE_SIZE=200000
# ASIS_CODING_MAX_OUTPUT_SIZE: positive integer max captured output bytes.
ASIS_CODING_MAX_OUTPUT_SIZE=60000

# ---- Paths (all optional absolute/~/ directories; platform defaults apply) ----
# ASIS_DATA_DIRECTORY=
# ASIS_CONFIG_DIRECTORY=
# ASIS_CACHE_DIRECTORY=
# ASIS_LOG_DIRECTORY=
# ASIS_MEMORY_DIRECTORY=
# ASIS_RUNTIME_DIRECTORY=

# ---- C.O.R.E. integration (optional external infrastructure; standalone by default) ----
# The provisioning credential is runtime-only: export ASIS_CORE_CREDENTIAL in the
# shell before starting. It must NOT go in this file or any .env file.
# Present-but-invalid values raise ConfigurationError (never silent).
# ASIS_CORE_ENABLED: boolean.
ASIS_CORE_ENABLED=false
# ASIS_CORE_HOST: non-empty hostname/IP of CORE-HOST.
ASIS_CORE_HOST=127.0.0.1
# ASIS_CORE_PORT: integer 1-65535.
ASIS_CORE_PORT=5000
# ASIS_CORE_DEVICE_FILE: optional remembered-device path (default ~/.risarms-device.json).
# ASIS_CORE_DEVICE_FILE=
# ASIS_CORE_CA_FILE: optional host public cert for TLS verification.
# ASIS_CORE_CA_FILE=
# ASIS_CORE_INSECURE: boolean, skip TLS verification (trusted LAN only).
ASIS_CORE_INSECURE=false
# ASIS_CORE_CONNECT_TIMEOUT / ASIS_CORE_REQUEST_TIMEOUT: integers 1-600 seconds.
ASIS_CORE_CONNECT_TIMEOUT=10
ASIS_CORE_REQUEST_TIMEOUT=30
# ASIS_CORE_RECONNECT_ENABLED: boolean.
ASIS_CORE_RECONNECT_ENABLED=true
# ASIS_CORE_RECONNECT_DELAY: integer 0-300 seconds base backoff.
ASIS_CORE_RECONNECT_DELAY=5
