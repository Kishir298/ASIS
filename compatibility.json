{
  "schema_version": 1,
  "project": "ASIS",
  "display_name": "A.S.I.S. — A Smart Intelligence System",
  "version": "0.1.0",
  "release_channel": "stable",
  "standalone": true,
  "requires_core": false,
  "supported_operating_systems": [
    {
      "os": "windows",
      "architectures": ["x86_64", "arm64"],
      "minimum_version": "10 22H2",
      "notes": "PowerShell 5.1 supported; WSL/Bash not required."
    },
    {
      "os": "macos",
      "architectures": ["x86_64", "arm64"],
      "minimum_version": "12.0",
      "notes": "Apple Silicon and Intel packages are built separately."
    },
    {
      "os": "linux",
      "architectures": ["x86_64", "arm64"],
      "minimum_version": "glibc 2.28",
      "notes": "ARM64 supported where binary dependencies permit."
    }
  ],
  "runtime": {
    "kind": "python",
    "minimum_version": "3.11",
    "console_scripts": ["asis", "asis-tui"],
    "install_methods": ["pip", "pipx", "standalone-executable"]
  },
  "core_integration": {
    "optional": true,
    "protocol_versions": ["0.3.0", "0.4.0"],
    "credential_env": "ASIS_CORE_CREDENTIAL",
    "enable_env": "ASIS_CORE_ENABLED",
    "offline_fallback": true
  },
  "integrations": ["core-client", "ascs", "ollama", "documents", "voice"],
  "build_metadata": {
    "builder": "GitHub Actions",
    "artifact_naming": "ASIS-{version}-{os}-{arch}-{format}",
    "checksums": "SHA-256",
    "sbom": "CycloneDX JSON"
  }
}
